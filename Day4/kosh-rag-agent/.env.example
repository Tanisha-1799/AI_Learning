OPENAI_API_KEY="paste-your-key-here"
# Optional for corporate SSL inspection environments:
# OPENAI_CA_BUNDLE=C:\\path\\corp-root-ca.pem

# Preferred secure setup in corporate networks
# OPENAI_CA_BUNDLE=C:\\path\\corp-root-ca.pem

# Proxy and gateway options (if required)
# OPENAI_PROXY=http://proxy-host:port
# OPENAI_BASE_URL=https://your-gateway.example/v1

# Network tuning
OPENAI_TIMEOUT_SEC=120
OPENAI_MAX_RETRIES=5
OPENAI_USE_SYSTEM_CERT_STORE=true

# Local debug only (unsafe)
# ALLOW_INSECURE_SSL=true
# ALLOW_INSECURE_SSL="true"
